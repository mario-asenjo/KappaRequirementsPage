{
  "name": "kappa-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "update:tasks": "tsx scripts/fetchTasks.ts",
    "update:achievements": "tsx scripts/fetchAchievements.ts",
    "update:item-requirements": "tsx scripts/fetchItemRequirements.ts",
    "extract:logs": "tsx tools/eft-log-importer/cli.ts",
    "build:extractor-download": "tsx scripts/buildExtractorDownload.ts",
    "build:goals": "tsx scripts/buildGoals.ts",
    "build:quests": "tsx scripts/buildQuestTree.ts",
    "test:quests": "tsx scripts/testQuestTree.tsx",
    "test:progress": "tsx scripts/testProgressModel.ts",
    "test:import": "tsx scripts/testProgressImport.ts",
    "test:extractor": "tsx scripts/testEftLogImporter.ts",
    "test:extractor-download": "npm run build:extractor-download && node public/downloads/eft-log-importer.mjs --help && node -e \"const fs=require('fs'); const zip=fs.readFileSync('public/downloads/eft-log-importer.zip'); if(!zip.includes(Buffer.from('run-windows.bat')) || !zip.includes(Buffer.from('run-linux.sh')) || !zip.includes(Buffer.from('README.txt'))) process.exit(1);\"",
    "test:achievements": "tsx scripts/testAchievementsPage.tsx",
    "test:item-requirements": "tsx scripts/testItemRequirements.ts",
    "test:fandom-item-requirements": "tsx scripts/testFandomItemRequirements.ts",
    "test:maps": "tsx scripts/testMapData.ts",
    "test:map-markers": "tsx scripts/testMapMarkers.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.0.2",
    "vite": "^4.2.0"
  }
}
